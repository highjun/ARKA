{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:storybook": "storybook dev --no-open -p 6006",
    "build:storybook": "storybook build -o .output/storybook-static",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"**/*.css\" --max-warnings 0",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "test:e2e:critical": "playwright test -c test/e2e/playwright.config.ts --grep @critical",
    "test:visual-regression": "node test/visual-regression/run.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@iconify-json/codicon": "^1.2.72",
    "@iconify/react": "^6.0.2",
    "@lezer/highlight": "^1.2.3",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.38.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "contracts": "workspace:*",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@playwright/test": "catalog:",
    "@primer/stylelint-config": "^13.6.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-primer-react": "^9.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "http-server": "^14.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "ops": "workspace:*",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "catalog:"
  },
  "imports": {
    "#component/*": "./src/shared/component/*/index.ts",
    "#contracts": "contracts",
    "#core/*": "./src/core/*/index.ts",
    "#core/errors": "./src/core/errors.ts",
    "#utils/*": "./src/shared/utils/*.tsx",
    "#visual-regression": "./src/shared/visualRegression.ts",
    "#workbench": "./src/workbench/index.ts"
  }
}
