{
  "name": "arkashic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "task": "pnpm --filter ops run task",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "commit-msg": "node ops/hooks/commitMsg.ts $1",
    "pre-push": "node ops/hooks/prePush.ts"
  }
}
