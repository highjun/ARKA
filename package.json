{
  "name": "arkashic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify": "pnpm run check && pnpm run build && pnpm --filter client run test:e2e && pnpm --filter client run vrt && pnpm --filter ops run smoke",
    "task": "pnpm --filter ops run task",
    "start": "ADE_CLIENT_ROOT=.output/dist/client node .output/dist/server/index.js",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run check"
  }
}
