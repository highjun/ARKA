# CI의 `container` 잡이 쓰는 값. **전부 가짜다** — 진짜 시크릿은 여기 들어오지 않는다.
#
# 목적은 하나다: "빌드된 이미지가 실제로 뜨고 /api/health가 답한다"를 병합 전에 보장하는 것.
# 그래서 앱이 부팅에 필요한 최소값만 채운다.
#
#     docker compose -p ci -f ops/deploy/compose.yml --env-file ops/deploy/.env.ci up -d --build --wait
#
# `.gitignore`가 `.env.*`를 막으므로 이 파일만 예외로 풀어 두었다.

# 러너에서 3000이 비어 있으리라는 보장이 없다. 겹치지 않을 자리를 쓴다.
ADE_PORT=3998

# **워크스페이스는 실재하는 디렉터리여야 한다** — 없으면 부팅에서 죽는다(core/config.ts).
# 워크플로가 이 경로를 먼저 `mkdir -p`한다. 없는 채로 두면 docker가 root 소유로 만들어
# 컨테이너가 쓰지 못한다.
ADE_WORKSPACE=/tmp/ade-ci-workspace

# `ADE_ANTHROPIC_API_KEY`를 **아예 적지 않는다.** 값이 있으면 CI가 외부 API를 부르고,
# 빈 문자열로 적으면 스키마의 `min(1)`에 걸려 부팅에서 죽는다 — "없음"과 ""는 다르다.
# 변수가 없어야 ScriptedRunner로 폴백해 네트워크 호출이 0이 된다(ADR 0019).

# 러너 사용자의 uid/gid로 덮어쓴다 — 셸 환경이 `--env-file`보다 우선한다.
# 여기 값은 그 덮어쓰기가 빠졌을 때의 보루다.
ADE_UID=1001
ADE_GID=1001
