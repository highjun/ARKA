# [설정] compose 프로젝트와 컨테이너 이름의 앞자리. 비우면 `arka` → `arka-app`·`arka-tunnel`.
ARKA_NAME=

# [설정] 띄울 이미지 태그. 비우면 `arka:local` — 없으면 그 자리에서 빌드한다.
ARKA_IMAGE=

# [설정] 컨테이너가 돌 uid/gid — `id -u`, `id -g`.
# 안 맞으면 컨테이너가 만든 파일을 호스트 사용자가 고치지 못한다.
ARKA_UID=
ARKA_GID=

# [설정] 워크스페이스로 마운트할 호스트 경로. 
ARKA_WORKSPACE=

# [설정] 컨테이너 **안**의 값. **`compose.yml`에 기본값이 없으므로 전부 채운다.**
# 바깥과 이름이 같은 셋(`HOST`·`PORT`·`WORKSPACE`)은 뜻이 달라 `CONTAINER`를 붙였다.
# **값 뒤에 주석을 달지 않는다** — compose가 안 떼고 값으로 읽는다.
NODE_ENV=production

# `127.0.0.1`로 두면 터널도 헬스체크도 못 닿는다.
ARKA_CONTAINER_HOST=0.0.0.0

# compose 헬스체크와 터널 ingress가 같이 본다.
ARKA_CONTAINER_PORT=3000

# 위 `ARKA_WORKSPACE`가 물리는 자리.
ARKA_CONTAINER_WORKSPACE=/workspace

# 이미지 안의 정적 파일 자리 — Dockerfile의 `COPY`가 정한다.
ARKA_CLIENT_ROOT=/app/dist/client

# [설정] 실제 배포될 URL
ARKA_ORIGIN=

# [설정] cloudflared 설정 파일의 위치
# `cloudflare-config.example.yml`을 해당 위치로 복사해 터널 ID와 호스트 이름을 채운다.
ARKA_TUNNEL_CONFIG=

# [비밀] 터널 자격증명(`<터널ID>.json`)의 위치
ARKA_TUNNEL_CREDENTIALS=
