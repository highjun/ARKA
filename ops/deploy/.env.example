# 이 파일을 `ops/secure/.env`로 복사하고 빈칸을 채운다.
#
#     cp ops/deploy/.env.example ops/secure/.env
#     docker compose -f ops/deploy/compose.yml --env-file ops/secure/.env up
#
# **값은 전부 `ops/secure/`에 있다** — 리포 밖에 흩어 두지 않는다. 추적하지 않는다.
#
# 배포 잡은 러너의 **다른 클론**에서 돌고 `actions/checkout`이 무시된 파일을 지우므로
# 그 클론에는 이 폴더가 없다. 그래서 GitHub 환경 변수 `ARKA_SECURE`가 이 기계의
# `ops/secure` 절대경로를 가리키고, 배포 잡은 그것을 읽는다.
#
# **CI도 이 파일을 읽지 않는다.** 필요한 넷(`ARKA_NAME`·`ARKA_WORKSPACE`·`ARKA_UID`·`ARKA_GID`)을
# 워크플로가 직접 넘긴다 — 나머지는 `compose.yml`의 `${VAR:-기본값}`이 받는다.
#
# 여기 없는 `ARKA_HOST`·`ARKA_PORT`(컨테이너 안)·`ARKA_CLIENT_ROOT`·`ARKA_GIT_SHA`는
# **이미지가 굽는다.** [ ] 안은 등급이다. **[비밀]은 git에 넣지 않는다.**

# [설정] compose 프로젝트와 컨테이너 이름의 앞자리. 비우면 `arka` → `arka-app`·`arka-tunnel`.
ARKA_NAME=

# [설정] 띄울 이미지 태그. 비우면 `arka:local` — 없으면 그 자리에서 빌드한다.
ARKA_IMAGE=

# [설정] 컨테이너가 돌 uid/gid — `id -u`, `id -g`.
# 안 맞으면 컨테이너가 만든 파일을 호스트 사용자가 고치지 못한다.
ARKA_UID=
ARKA_GID=

# [설정] 워크스페이스로 마운트할 호스트 경로. **실재해야 한다** — 없으면 부팅에서 죽는다.
ARKA_WORKSPACE=

# [설정] 컨테이너 **안**의 값. **`compose.yml`에 기본값이 없으므로 전부 채운다.**
# 바깥과 이름이 같은 셋(`HOST`·`PORT`·`WORKSPACE`)은 뜻이 달라 `CONTAINER`를 붙였다.
# **값 뒤에 주석을 달지 않는다** — compose가 안 떼고 값으로 읽는다.
NODE_ENV=production

# `127.0.0.1`로 두면 터널도 헬스체크도 못 닿는다.
ARKA_CONTAINER_HOST=0.0.0.0

# compose 헬스체크와 터널 ingress가 같이 본다.
ARKA_CONTAINER_PORT=3000

# 위 `ARKA_WORKSPACE`가 물리는 자리.
ARKA_CONTAINER_WORKSPACE=/workspace

# 이미지 안의 정적 파일 자리 — Dockerfile의 `COPY`가 정한다.
ARKA_CLIENT_ROOT=/app/dist/client

# [설정] 배포 스모크가 두드릴 오리진 — `https://<호스트>`. **리포에 호스트 이름을 적지 않는다.**
ARKA_ORIGIN=

# [설정] 터널이 쓸 설정 파일 자리. `renderTunnel.ts`가 여기에 쓴다.
ARKA_TUNNEL_CONFIG=

# [설정] 터널 ID와 공개 호스트 이름 — `--profile tunnel`일 때만 쓰인다.
# `ops/deploy/tunnel.template.yml`이 설정의 모양을 들고, 이 둘이 값을 채운다.
# **리포가 공개라 값은 여기 적지 않는다.**
ARKA_TUNNEL_ID=
ARKA_HOSTNAME=

# [비밀] 터널 자격증명(`<터널ID>.json`)의 **호스트 경로**. 이게 있으면 남이 터널을 가로챈다.
ARKA_TUNNEL_CREDENTIALS=
