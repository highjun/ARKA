# 이 파일을 `.env`로 복사하고 빈칸을 채운다. compose가 **자기 옆의 `.env`**를 읽는다.
#
#     cp ops/deploy/.env.example ops/deploy/.env
#
# **실배포는 이 파일을 읽지 않는다** — 이 기계의 `~/ARKA/secure/env/ade.env`(0600)를 배포 잡이
# 셸에 풀고 compose를 부른다. 값이 리포에 사본으로 남지 않게 하는 것이 그 이유다.
#
# 여기 없는 `ADE_HOST`·`ADE_PORT`(컨테이너 안)·`ADE_CLIENT_ROOT`·`ADE_DATA_DIR`·`ADE_GIT_SHA`는
# **이미지가 굽는다.** [ ] 안은 등급이다. **[비밀]은 git에 넣지 않는다.**

# [설정] compose 프로젝트와 컨테이너 이름의 앞자리. 비우면 `ade` → `ade-app`·`ade-tunnel`.
ADE_NAME=

# [설정] 띄울 이미지 태그. 비우면 `ade:local` — 없으면 그 자리에서 빌드한다.
ADE_IMAGE=

# [설정] 컨테이너가 돌 uid/gid — `id -u`, `id -g`.
# 안 맞으면 컨테이너가 만든 파일을 호스트 사용자가 고치지 못한다.
ADE_UID=
ADE_GID=

# [설정] 워크스페이스로 마운트할 호스트 경로. **실재해야 한다** — 없으면 부팅에서 죽는다.
ADE_WORKSPACE=

# [설정] SQLite가 사는 자리. 비우면 이름 있는 볼륨 `ade-data`.
# 실배포는 워크스페이스 **안**의 경로를 주어 파일 트리에도 보이게 한다.
ADE_DATA=

# [설정] `compose.local.yml`을 함께 쓸 때 호스트 루프백에 여는 포트. 비우면 3000.
ADE_PORT=

# [설정] 실행기 — `scripted` 또는 `anthropic`. 비우면 서버 스키마의 기본값이 든다.
# **켜는 것은 이 값이지 아래 키가 아니다.** `anthropic`으로 켜면 키가 없을 때 부팅에서 죽는다.
ADE_AGENT_RUNNER=

# [설정] 에이전트 모델. 비우면 같은 스키마의 기본값이 든다.
ADE_ANTHROPIC_MODEL=

# [비밀] `ADE_AGENT_RUNNER=anthropic`일 때만 쓰인다.
ADE_ANTHROPIC_API_KEY=

# [설정] 배포 스모크가 두드릴 오리진 — `https://<호스트>`. **리포에 호스트 이름을 적지 않는다.**
ADE_ORIGIN=

# [비밀] cloudflared 커넥터 토큰 — `--profile tunnel`일 때만 쓰인다.
# Cloudflare 대시보드에서 만든 터널의 것이다(→ docs/operations.md).
TUNNEL_TOKEN=
