# 이 파일을 `.env`로 복사하고 빈칸을 채운다. compose가 **자기 옆의 `.env`**를 읽는다.
#
#     cp ops/deploy/.env.example ops/deploy/.env
#
# 정본은 `compose.yml`이다 — 여기 키가 그것과 어긋나면 `pnpm --filter ops check`가 실패한다.
# 여기 없는 `ADE_HOST`·`ADE_CLIENT_ROOT`·`ADE_DATA_DIR`·`ADE_GIT_SHA`는 **이미지가 굽는다.**
# [ ] 안은 등급이다(→ ADR 0007). **[비밀]은 git에 넣지 않는다.**

# [설정] 호스트 루프백에 여는 포트. 비우면 3000.
ADE_PORT=

# [설정] 컨테이너가 돌 uid/gid — `id -u`, `id -g`.
# 안 맞으면 컨테이너가 만든 파일을 호스트 사용자가 고치지 못한다.
ADE_UID=
ADE_GID=

# [설정] 워크스페이스로 마운트할 호스트 경로. **실재해야 한다** — 없으면 부팅에서 죽는다.
ADE_WORKSPACE=

# [설정] 실행기 — `scripted` 또는 `anthropic`. 비우면 scripted.
# **켜는 것은 이 값이지 아래 키가 아니다**(→ ADR 0007). anthropic으로 켜면 키가 없을 때 부팅에서 죽는다.
ADE_AGENT_RUNNER=

# [설정] 에이전트 모델. 비우면 claude-opus-5.
ADE_ANTHROPIC_MODEL=

# [비밀] `ADE_AGENT_RUNNER=anthropic`일 때만 쓰인다. 실배포에서는 이 파일이 아니라
# `~/ARKA/secure/env/`에 두고 스펙의 `envFile`로 가리킨다.
ADE_ANTHROPIC_API_KEY=
