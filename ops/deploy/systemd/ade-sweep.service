# 버려진 미리보기를 걷는다. **사용자 유닛이다** — sudo가 필요 없다.
# 설치: cp ops/deploy/systemd/* ~/.config/systemd/user/ && systemctl --user enable --now ade-sweep.timer
[Unit]
Description=ADE 미리보기 청소
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/ARKASHIC
ExecStart=/usr/bin/env node %h/ARKASHIC/ops/deploy/cli.ts sweep
Environment=HOME=%h
Environment=PATH=%h/.nvm/versions/node/v24.15.0/bin:%h/.local/bin:%h/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
