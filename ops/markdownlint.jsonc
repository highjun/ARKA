{
  // 문서를 기계가 보는 자리. 이 저장소의 마크다운은 2026-09-14까지 **검사가 0건**이었다.
  //
  // 끈 규칙은 전부 **ADR 형식과 정면으로 맞서는 것**이다(→ docs/adr/0004-comment-rules.md의
  // 이웃인 docs/CONVENTIONS.md가 그 형식을 정한다). 본문 40줄 상한이 있는 문서에서 줄을 접거나
  // 절마다 빈 줄을 넣으면 상한을 형식이 먹는다.
  "config": {
    // 줄을 접으면 줄 수가 늘어 ADR 본문 40줄 상한을 먹는다. 크기는 그 상한이 본다.
    "line-length": false,
    // ADR은 `## 결정:` 바로 아래 첫 불릿이 온다. 빈 줄을 넣으면 ADR마다 여섯 줄이 는다.
    "blanks-around-headings": false,
    "blanks-around-lists": false,
    // 절 이름이 `## 맥락:`이다 — 콜론이 형식의 일부다.
    "no-trailing-punctuation": false,
    // `<대안> — <사유>`처럼 자리표시자에 꺾쇠를 쓴다. HTML이 아니다.
    "no-inline-html": false,
    // 태스크 파일이 frontmatter로 시작한다.
    "first-line-heading": false,
    // 표는 `compact`로 고정한다. 기본값(`any`)은 `aligned`도 받는데 그건 **글자 수** 정렬이라
    // 한글 표에서 화면 정렬과 어긋난다 — 규칙이 재는 것과 사람이 보는 것이 달라진다.
    "table-column-style": { "style": "compact" }
  },
  "globs": [
    "**/*.md",
    "!**/node_modules/**",
    "!.output/**",
    // 추적하지 않는 사용자 개인 메모(→ CLAUDE.md).
    "!docs/USER_NOTE.md",
    // 테스트가 읽고 쓰는 자료다. 문서가 아니다.
    "!packages/client/test/e2e/fixture/**"
  ]
}
